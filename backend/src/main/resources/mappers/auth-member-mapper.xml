<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="AuthMember">

	<!-- 로그인 아이디 → 회원번호 · 권한 · 상태 (없으면 null) -->
	<select id="selectAuthMember" parameterType="string" resultType="com.app.silhouette.commons.AuthMemberDTO">
		select member_seq, login_id, nickname, role, member_status
		  from member
		 where login_id = #{loginId}
	</select>
</mapper>