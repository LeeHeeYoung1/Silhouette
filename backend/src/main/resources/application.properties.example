spring.application.name=backend
server.port=80

# Oracle
spring.datasource.url=
spring.datasource.username=
spring.datasource.password=
spring.datasource.driver-class-name=oracle.jdbc.OracleDriver

# MyBatis
mybatis.mapper-locations=classpath:mappers/*.xml

# JWT (secret은 32바이트 이상)
jwt.secret=
jwt.expiration=

# Google Cloud Storage (키 파일은 resources에 두고 Git에 올리지 않음)
gcp.credentials.location=classpath:
gcp.project.id=
gcp.bucket=

# LiveKit
livekit.url=
livekit.api-key=
livekit.api-secret=
live.max-viewers=50

# Upload
spring.servlet.multipart.max-file-size=20MB
spring.servlet.multipart.max-request-size=25MB

# Spring AI - Gemini (AI 챗봇 / 블라인드 채팅 AI 추천답변)
#  - 챗봇 기능 때문에 api-key가 비어 있으면 서버가 켜지지 않음 → 팀에서 공유한 키를 꼭 넣기
#  - 키는 Google AI Studio에서 발급, 절대 Git에 올리지 않기
#  - thinking-level=minimal: 답변 전 "생각" 단계를 줄여 응답 속도 향상 (모델이 지원 안 한다는 에러가 나면 이 줄 삭제)

spring.ai.model.chat=google-genai
spring.ai.google.genai.api-key=
spring.ai.google.genai.chat.options.model=gemini-3.5-flash-lite
spring.ai.google.genai.chat.options.thinking-level=minimal

spring.ai.retry.max-attempts=1

ai.models=gemini-3.5-flash-lite,gemini-3.1-flash-lite
ai.hedge-ms=8000
ai.timeout-ms=20000
spring.ai.retry.max-attempts=2

#  - retry.max-attempts=2: 한도 초과(429) 등 에러 시 30초 넘게 재시도하지 않고 바로 실패 처리

# 블라인드 채팅 (기본값: 대화 15분, GO/STOP 선택 30초 / 테스트할 때 시간을 줄여서 사용)
blind.time-limit-min=15
blind.vote-seconds=30

ai.server.url=

# Sightengine AI Image Detection
sightengine.api.url=
sightengine.api.user=
sightengine.api.secret=
